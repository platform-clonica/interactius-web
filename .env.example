# URL base del sitio — se usa para canonicals, OG, hreflang.
# En producción: https://www.interactius.com
# En staging/preview: la URL real del entorno (cualquier cosa que no sea el
# dominio canónico activa robots: noindex automáticamente).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Código de verificación de Google Search Console.
# Se obtiene de Search Console al añadir la propiedad.
# Se renderiza como <meta name="google-site-verification">.
NEXT_PUBLIC_GSC_VERIFICATION=

# --------------------------------------------------------------------------
# Hubspot — Sprint 6
# --------------------------------------------------------------------------
# Credenciales de la cuenta Hubspot.
# Portal ID: Settings → Account Management → Account → Account ID.
HUBSPOT_PORTAL_ID=

# Private App access token (preferido sobre API key legacy).
# Settings → Integrations → Private Apps → Create private app.
# Scopes mínimos: forms (write), crm.objects.contacts (write).
HUBSPOT_ACCESS_TOKEN=

# Form ID de cada formulario — se obtiene en Hubspot Marketing → Forms → ID.
HUBSPOT_FORM_ID_CONTACT=
HUBSPOT_FORM_ID_NEWSLETTER=

# --------------------------------------------------------------------------
# Testers — Insight Panel® (proveedor pendiente de decisión interna)
# --------------------------------------------------------------------------
TESTERS_PROVIDER=
TESTERS_API_KEY=
