# URL base del sitio — se usa para canonicals, OG, hreflang.
# En producción: https://www.interactius.com
# En staging/preview: la URL real del entorno (cualquier cosa que no sea el
# dominio canónico activa robots: noindex automáticamente).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Código de verificación de Google Search Console.
# Se obtiene de Search Console al añadir la propiedad.
# Se renderiza como <meta name="google-site-verification">.
NEXT_PUBLIC_GSC_VERIFICATION=

# --------------------------------------------------------------------------
# Hubspot — Forms Submissions API público
# --------------------------------------------------------------------------
# Portal ID — Settings → Account Management → Account → Account ID.
# Es un identificador público (aparece en el HTML de cualquier embed); no es
# un secreto. Lo excluimos del secrets-scanning de Netlify (netlify.toml).
HUBSPOT_PORTAL_ID=

# Form IDs — Hubspot Marketing → Forms → Form ID. Públicos, no son secretos.
HUBSPOT_FORM_ID_CONTACT=
HUBSPOT_FORM_ID_NEWSLETTER=
HUBSPOT_FORM_ID_TESTERS=

# Private App access token (opcional). Sin esto los endpoints siguen
# funcionando contra el Forms API público; solo se necesita si el form
# requiere autenticación (no es nuestro caso). Settings → Integrations
# → Private Apps → Create. Scopes: forms (write), crm.objects.contacts (write).
HUBSPOT_ACCESS_TOKEN=
